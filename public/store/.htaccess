RewriteRule ^2026/10/19/what-is-ai-visibility$ 2026/10/19/what-is-ai-visibility/index.html [END]
RewriteRule ^2026/10/19/what-is-ai-visibility/$ 2026/10/19/what-is-ai-visibility/index.html [END]

RewriteRule ^services/lead-funnel-automation$ services/lead-funnel-automation/index.html [END]
RewriteRule ^services/lead-funnel-automation/$ services/lead-funnel-automation/index.html [END]

RewriteRule ^services/content-creation$ services/content-creation/index.html [END]
RewriteRule ^services/content-creation/$ services/content-creation/index.html [END]

RewriteRule ^2026/10/19/what-is-aeo$ 2026/10/19/what-is-aeo/index.html [END]
RewriteRule ^2026/10/19/what-is-aeo/$ 2026/10/19/what-is-aeo/index.html [END]

RewriteRule ^services/ai-visibility$ services/ai-visibility/index.html [END]
RewriteRule ^services/ai-visibility/$ services/ai-visibility/index.html [END]

RewriteRule ^services/advertising$ services/advertising/index.html [END]
RewriteRule ^services/advertising/$ services/advertising/index.html [END]

RewriteRule ^services/seo-geo$ services/seo-geo/index.html [END]
RewriteRule ^services/seo-geo/$ services/seo-geo/index.html [END]

RewriteRule ^the-deciblog$ the-deciblog/index.html [END]
RewriteRule ^the-deciblog/$ the-deciblog/index.html [END]

RewriteRule ^why-decibl$ why-decibl/index.html [END]
RewriteRule ^why-decibl/$ why-decibl/index.html [END]

RewriteRule ^contact-2$ contact-2/index.html [END]
RewriteRule ^contact-2/$ contact-2/index.html [END]

RewriteRule ^services$ services/index.html [END]
RewriteRule ^services/$ services/index.html [END]

RewriteRule ^about$ about/index.html [END]
RewriteRule ^about/$ about/index.html [END]

RewriteRule .* - [F]
</IfModule>
# END ScrapingVisitor

